{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.example.com/charts/microservice/values.schema.json",
  "title": "microservice chart values",
  "description": "Contract for the platform microservice chart. `global` is injected by the deploy pipeline; every other key is developer intent from deploy/values-<env>.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "service",
    "image",
    "probes"
  ],
  "properties": {
    "global": {
      "description": "Environment facts injected by the deploy pipeline. Developers must not set these.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "accountId",
        "region",
        "clusterName",
        "oidcProviderArn",
        "oidcIssuer"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "enum": [
            "staging",
            "prod"
          ]
        },
        "accountId": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]$"
        },
        "clusterName": {
          "type": "string",
          "minLength": 1
        },
        "oidcProviderArn": {
          "type": "string",
          "pattern": "^arn:aws:iam::[0-9]{12}:oidc-provider/.+$"
        },
        "oidcIssuer": {
          "type": "string",
          "pattern": "^[^:/]+(/.*)?$",
          "description": "Issuer host/path without scheme."
        },
        "vpcId": {
          "type": "string"
        },
        "dbSubnetGroupName": {
          "type": "string"
        },
        "nodeSecurityGroupId": {
          "type": "string"
        },
        "prometheusAddress": {
          "type": "string",
          "format": "uri"
        },
        "local": {
          "type": "boolean"
        },
        "awsEndpointUrl": {
          "type": "string"
        },
        "awsS3EndpointUrl": {
          "type": "string",
          "description": "Local mode only: S3 endpoint for virtual-hosted-style requests (LocalStack needs <bucket>.s3.<host>)."
        },
        "permissionsBoundaryArn": {
          "type": "string",
          "pattern": "^(arn:aws:iam::[0-9]{12}:policy/.+)?$",
          "description": "Boundary every service role is created with (infra/terraform platform-iam). The ACK IAM controller cannot create roles without it."
        },
        "releaseId": {
          "type": "string",
          "description": "Unique id of the deploy run (stamped on the pod template)."
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "team"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z]([-a-z0-9]{0,30}[a-z0-9])?$",
          "description": "DNS-1123 label, max 32 chars (leaves room for AWS name suffixes)."
        },
        "team": {
          "type": "string",
          "pattern": "^[a-z][-a-z0-9]{1,40}$"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "latest"
            ]
          },
          "description": "Immutable tag (git SHA). `latest` is rejected."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "containerPort": {
      "$ref": "#/definitions/port"
    },
    "env": {
      "type": "object",
      "description": "Extra plain env vars. Names reserved for platform injection (AWS_*, SQS_*, SNS_*, S3_*, DYNAMODB_*, RDS_*, PLATFORM_*) are rejected.",
      "propertyNames": {
        "pattern": "^[A-Z_][A-Z0-9_]*$",
        "not": {
          "pattern": "^(AWS|SQS|SNS|S3|DYNAMODB|RDS|PLATFORM)_"
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceList"
        },
        "limits": {
          "$ref": "#/definitions/resourceList"
        }
      }
    },
    "probes": {
      "description": "Health contract. Liveness and readiness endpoints are mandatory.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveness",
        "readiness"
      ],
      "properties": {
        "liveness": {
          "$ref": "#/definitions/probe"
        },
        "readiness": {
          "$ref": "#/definitions/probe"
        },
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "$ref": "#/definitions/httpPath"
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/httpPath"
        },
        "port": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/port"
            }
          ]
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 10,
          "maximum": 100
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canaryWeights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        },
        "pauseSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[0-9]+(s|m)$"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "failureLimit": {
              "type": "integer",
              "minimum": 0
            },
            "maxHttpErrorRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "maxWorkFailureRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "expose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "port": {
              "$ref": "#/definitions/port"
            }
          }
        },
        "loadBalancer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "alb",
                "nlb"
              ]
            },
            "scheme": {
              "type": "string",
              "enum": [
                "internal",
                "internet-facing"
              ]
            },
            "host": {
              "type": "string"
            },
            "path": {
              "$ref": "#/definitions/httpPath"
            },
            "certificateArn": {
              "type": "string"
            }
          }
        }
      }
    },
    "aws": {
      "description": "AWS resources owned by this service. Each entry is provisioned through kro + ACK with an IAM policy scoped to that resource only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sqs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sqs"
          }
        },
        "sns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sns"
          }
        },
        "s3": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/s3"
          }
        },
        "dynamodb": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dynamodb"
          }
        },
        "rds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rds"
          }
        }
      }
    }
  },
  "definitions": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "httpPath": {
      "type": "string",
      "pattern": "^/[-a-zA-Z0-9_./]*$"
    },
    "resourceName": {
      "type": "string",
      "pattern": "^[a-z]([-a-z0-9]{0,22}[a-z0-9])?$",
      "description": "Logical name, unique per resource type within the service."
    },
    "deletionPolicy": {
      "type": "string",
      "enum": [
        "retain",
        "delete"
      ],
      "description": "What happens to the AWS resource when the service is decommissioned."
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": [
            "string",
            "number"
          ]
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/httpPath"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "keyAttr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "binary"
          ],
          "description": "Attribute type. Spelled out (not S/N/B) because YAML 1.1 parses a bare N as boolean."
        }
      }
    },
    "sqs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "access"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/resourceName"
        },
        "access": {
          "type": "string",
          "enum": [
            "consume",
            "publish",
            "consumepublish"
          ]
        },
        "fifo": {
          "type": "boolean"
        },
        "visibilityTimeoutSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 43200
        },
        "messageRetentionSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 1209600
        }
      }
    },
    "sns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "access"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/resourceName"
        },
        "access": {
          "type": "string",
          "enum": [
            "publish"
          ]
        },
        "fifo": {
          "type": "boolean"
        }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "access"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/resourceName"
        },
        "access": {
          "type": "string",
          "enum": [
            "read",
            "readwrite"
          ]
        },
        "versioning": {
          "type": "boolean"
        },
        "deletionPolicy": {
          "$ref": "#/definitions/deletionPolicy"
        }
      }
    },
    "dynamodb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "access",
        "partitionKey"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/resourceName"
        },
        "access": {
          "type": "string",
          "enum": [
            "read",
            "readwrite"
          ]
        },
        "partitionKey": {
          "$ref": "#/definitions/keyAttr"
        },
        "sortKey": {
          "$ref": "#/definitions/keyAttr"
        },
        "deletionPolicy": {
          "$ref": "#/definitions/deletionPolicy"
        }
      }
    },
    "rds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "engine",
        "access"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/resourceName"
        },
        "engine": {
          "type": "string",
          "enum": [
            "postgres",
            "mysql"
          ]
        },
        "engineVersion": {
          "type": "string"
        },
        "instanceClass": {
          "type": "string",
          "pattern": "^db\\.[a-z0-9]+\\.[a-z0-9]+$"
        },
        "allocatedStorageGB": {
          "type": "integer",
          "minimum": 20,
          "maximum": 1000
        },
        "access": {
          "type": "string",
          "enum": [
            "connect"
          ]
        },
        "deletionPolicy": {
          "$ref": "#/definitions/deletionPolicy"
        }
      }
    }
  }
}
